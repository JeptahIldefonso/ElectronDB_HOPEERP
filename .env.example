# ========================================================================
# HOPE Group4 / ElectronDB: ENVIRONMENT VARIABLES (TEMPLATE)
# Provide your credentials in .env.local (development) or Vercel Settings
# ========================================================================

# Supabase Credentials (Optional for local SQLite; required for Cloud sync)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# App Configuration
NEXT_PUBLIC_APP_NAME="HOPE Group4 - Sales and Collections Monitoring System"
NEXT_PUBLIC_APP_URL="https://electrondb-erp.vercel.app"

# Optional read-only demonstration mode toggle (default false)
NEXT_PUBLIC_IS_READONLY=false

# Turso Cloud Database (Optional for local SQLite; recommended for persistent production auth & data)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Session Security Secret (HMAC-SHA256 signing for httpOnly session cookies)
AUTH_SECRET="change-this-to-a-secure-random-secret-key"
# Optional fallback alias:
SESSION_SECRET=

# Developer Break-Glass Superadmin Configuration
# Next.js expands $ in .env files, which can corrupt bcrypt hashes starting with $2b$...
# You can provide this in either format:
# Option 1 (Recommended): Base64 encoded hash: DEV_ADMIN_PASSWORD_HASH="base64:<base64-string>"
#   Generate with: node -e "console.log('base64:' + Buffer.from(require('bcryptjs').hashSync('your-password', 10)).toString('base64'))"
# Option 2: Escaped $ format: DEV_ADMIN_PASSWORD_HASH="\$2b\$10\$..."
DEV_ADMIN_PASSWORD_HASH=
DEV_ADMIN_EMAIL="ildefonsojeptahashleyr@gmail.com"
