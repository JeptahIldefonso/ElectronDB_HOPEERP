# Dependencies
/node_modules
/.pnp
.pnp.*
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js and build output
/.next/
/out/
/build
/dist
*.tsbuildinfo
next-env.d.ts

# Vercel
.vercel

# Environment and secrets (only .env.example is tracked)
.env
.env.*
*.env
.env.local
.env*.local
!.env.example
*.pem
*.key
*.p12
*.pfx

# Local databases. hope.db is the master seed and MUST stay tracked.
# Never add a blanket *.db rule.
hope.work.db
hope.work.db*
hope.work.db-*
auth.db
auth.db*
auth.db-*
*.db-wal
*.db-shm
*.db-journal
*-journal
*.sqlite
*.sqlite3
*.sqlite-*
*.sqlite3-journal

# Backups and dumps (contain password hashes)
backups/
*.bak
*.backup
turso-*-backup.sql

# Test and tooling output
/coverage
/test-results/
/playwright-report/
.eslintcache
.turbo/
.cache/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# OS
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Editors
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
*~

# Scratch and AI agent configurations
*.tmp
.tmp/
tmp/
scratch/
.agent/
.agents/
